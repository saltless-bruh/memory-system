# SNP Memory System — V3 environment
# scripts/bootstrap.sh copies this to .env when .env is absent. .env is
# gitignored; never commit secrets. Compose interpolates these values, and
# the host CLI reads them too. A commented line shows a Compose default: leave
# it commented unless you need a different value.

# ── Build provenance ──────────────────────────────────────────────────
# Stamped into the image as org.opencontainers.image.revision so a stale image
# is detectable. Leave it empty here and pass it on every build, because a
# value in this file goes stale with the next commit:
#   SNP_GIT_REVISION=$(git rev-parse HEAD) docker compose up -d --build
# A build without it is labelled `unknown`, which the preflight reports as
# unverifiable and `snpmemory status` as degraded.
SNP_GIT_REVISION=
# Local image names. Override only to keep a staging build from replacing the
# live tags (docs/runbook.md does this for a release candidate).
# SNP_SCOUT_IMAGE=snp-scout
# SNP_HOST_SYNC_IMAGE=snp-host-sync

# ── Gitea (T-0.1) ────────────────────────────────────────────────────
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA__server__ROOT_URL=http://localhost:3000/

# Only the optional Actions runner (`docker compose --profile runner up`)
# reads these; the runner stays disabled by default (ARCHITECTURE_STATUS OD-3).
# GITEA_INSTANCE_URL=http://git:3000
# GITEA_RUNNER_REGISTRATION_TOKEN=

# ── LiteLLM (T-0.2) ──────────────────────────────────────────────────
LITELLM_PORT=4000
# Master key gates the LiteLLM admin/proxy API. Required: Compose refuses to
# start without it. Change before any non-localhost exposure.
LITELLM_MASTER_KEY=

# ── Cloud API Models ───────────────────────────────────────────────────
# Specify the model names as passed to LiteLLM.
# The embedding model must be the one that built the index: a query embedded
# by a different model lands in a different vector space and ranks nonsense.
# The deployed corpus was built with Gemini, which is why this differs from
# Compose's own fallback (text-embedding-3-small); that fallback applies only
# when this line is removed. Changing it means re-embedding the whole corpus.
LITELLM_EMBED_MODEL=gemini/gemini-embedding-001
LITELLM_LLM_MODEL=gpt-4o
LITELLM_VLM_MODEL=gpt-4o
# The groundedness judge (`snp-judge`) runs on OpenRouter, so it needs
# OPENROUTER_API_KEY below. Compose's default route model:
# LITELLM_JUDGE_ROUTE_MODEL=openrouter/z-ai/glm-5.2:free

# ── API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=

# ── Vault paths (R-9.2: vault is files, not a container) ─────────────
WIKI_DIR=./wiki
RAW_DIR=./raw
# Document ACL map governing which departments may retrieve each raw file.
# A file matching no rule is not indexed; there is deliberately no fallback to
# the public `all` ACL. Leave this unset. The host CLI then uses
# <RAW_DIR>/.acl.yaml, and sync-job uses /data/raw/.acl.yaml inside its
# container. A value set here is ALSO interpolated into sync-job's container
# environment, where a host path such as ./raw/.acl.yaml names no file, and an
# ingester that cannot read its policy publishes nothing.
# RAW_ACL_FILE=/data/raw/.acl.yaml

# ── Isolated Git replica ─────────────────────────────────────────────
GIT_SYNC_URL=https://git.example.invalid/owner/snp-memory.git
GIT_BRANCH=main
# Required HMAC secret; set a generated value only in the untracked .env.
WEBHOOK_SECRET=
HOST_SYNC_PORT=9000
# A private repository needs a read-only Git identity. Store its token in the
# ignored .secrets/git_sync_token (mode 0600), then enable the committed
# overlay; see docs/runbook.md, "Private Git repositories".
# COMPOSE_FILE=docker-compose.yml:docker-compose.private-git.yml
# GIT_SYNC_USERNAME=snp-sync-reader
# GIT_SYNC_TOKEN_FILE=./.secrets/git_sync_token

# ── Scout authentication (JWT by default; fail-closed) ──────────────
SCOUT_AUTH_MODE=jwt
SCOUT_AUTH_BASE_URL=http://localhost:8080/mcp
SCOUT_JWT_ALGORITHM=RS256
SCOUT_JWT_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
SCOUT_JWT_ISSUER=https://identity.example.invalid/
SCOUT_JWT_AUDIENCE=snp-scout
SCOUT_JWT_DEPARTMENT_CLAIM=departments
# Loopback port Scout's MCP endpoint is published on.
# SCOUT_PORT=8080
# Static mode reads /run/secrets/scout_static_tokens_json, backed by the
# bootstrap-generated .secrets/scout_static_tokens.json file. Its schema is:
# {"<opaque-token>":{"subject":"<server-owned-id>","departments":["infra"]}}

# ── PostgreSQL + pgvector (Phase 2) ──────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=snp_rag
POSTGRES_MIGRATION_USER=postgres
POSTGRES_MIGRATION_PASSWORD_FILE=/run/secrets/postgres_admin_password
POSTGRES_QUERY_USER=rag_app_role
POSTGRES_QUERY_PASSWORD_FILE=/run/secrets/postgres_query_password
POSTGRES_INGEST_USER=rag_ingest_role
POSTGRES_INGEST_PASSWORD_FILE=/run/secrets/postgres_ingest_password
POSTGRES_PORT=5432

# ── Optional: explicit DNS for the gateway ───────────────────────────────────
# Only needed on a host whose /etc/resolv.conf is permanently a loopback
# resolver. Used exclusively by the opt-in docker-compose.dns.yml override:
#   SNP_DNS_SERVERS=10.0.0.53 \
#     docker compose -f docker-compose.yml -f docker-compose.dns.yml up -d
# Set it to YOUR site's resolver, never a public one (see docs/runbook.md 6.1).
# SNP_DNS_SERVERS=

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "snp-memory-agent",
  "version": "2.0.0",
  "description": "Connects an AI coding agent to the SNP Memory System V3 page-retrieval and authoring contracts through Scout and snpmemory MCP servers.",
  "author": {
    "name": "SNP Architecture Team"
  },
  "repository": "https://github.com/saltless-bruh/memory-system",
  "license": "MIT",
  "keywords": [
    "mcp",
    "rag",
    "knowledge-vault",
    "institutional-memory",
    "pgvector"
  ],
  "extensions": {
    "io.snp.memory": {
      "rbac": {
        "departments": ["redteam", "blueteam", "ai_eng", "infra"],
        "defaultScope": "ai_eng",
        "note": "A tool argument may narrow the caller's departments but never add or expand authority. The document ACL value `all` is not caller clearance."
      },
      "entrypoints": {
        "rules": "rules/snp-memory.md",
        "instructions": "instructions/",
        "workflows": "workflows/"
      },
      "requiredTools": {
        "note": "The declared tools are introspected against both in-process servers by tests/test_agent_package.py.",
        "scout": ["wiki_search", "wiki_read"],
        "snpmemory": [
          "verify",
          "plan_articles",
          "compile_plan",
          "compile_status",
          "wiki_search",
          "wiki_read"
        ]
      },
      "ships": {
        "note": "The authoritative portable inventory; synchronization tests enforce both presence and byte identity.",
        "skills": [
          "snp-bootstrap-system",
          "snp-compile-wiki",
          "snp-export-mcp",
          "snp-ingest-raw-data",
          "snp-query-wiki",
          "snp-read-wiki-page",
          "snp-verify-vault"
        ],
        "workflows": [
          "snp-compile.md",
          "snp-ingest.md",
          "snp-query.md",
          "snp-reload.md",
          "snp-verify.md"
        ],
        "instructions": [
          "agent_guide.instructions.md",
          "frontmatter_schema.instructions.md",
          "query_protocol.instructions.md"
        ],
        "rules": ["snp-memory.md"]
      },
      "repoLocal": {
        "note": "Not distributed: repository development instructions and the superpowers layer. Shared non-superpowers instructions remain mirrored into .claude; superpowers is excluded there because Claude uses unlazy completion discipline.",
        "prefixes": ["superpowers-"],
        "rules": ["superpowers.md"],
        "instructions": [
          "Roadmap.instructions.md",
          "coding_standards.instructions.md",
          "documentation_standards.instructions.md",
          "git_workflow.instructions.md",
          "internet_search.instructions.md",
          "task_completion_workflow.instructions.md",
          "testing_strategy.instructions.md"
        ]
      }
    }
  }
}

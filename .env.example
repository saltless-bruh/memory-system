# SNP Memory System — Phase 0 environment
# Copy to .env and adjust. .env is gitignored (never commit secrets).

# ── Gitea (T-0.1) ────────────────────────────────────────────────────
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA__server__ROOT_URL=http://localhost:3000/

# ── LiteLLM (T-0.2) ──────────────────────────────────────────────────
LITELLM_PORT=4000
# Master key gates the LiteLLM admin/proxy API. Change before any
# non-localhost exposure.
LITELLM_MASTER_KEY=sk-local-dev-change-me

# ── Cloud API Models ───────────────────────────────────────────────────
# Specify the model names as passed to LiteLLM
LITELLM_EMBED_MODEL=text-embedding-3-small
LITELLM_LLM_MODEL=gpt-4o
LITELLM_VLM_MODEL=gpt-4o

# ── API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Vault paths (R-9.2: vault is files, not a container) ─────────────
WIKI_DIR=./wiki
RAW_DIR=./raw

# ── PostgreSQL + pgvector (Phase 2) ──────────────────────────────────
POSTGRES_DB=snp_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_secret
POSTGRES_APP_USER=rag_app_role
POSTGRES_APP_PASSWORD=rag_app_secret
POSTGRES_PORT=5432

FROM python:3.12-slim
RUN apt-get update && apt-get install -y git curl && rm -rf /var/lib/apt/lists/*
RUN git config --global --add safe.directory /vault-replica/repository
RUN pip install --no-cache-dir fastapi uvicorn
COPY host_sync.py /app/host_sync.py
WORKDIR /app
EXPOSE 9000
CMD ["uvicorn", "host_sync:app", "--host", "0.0.0.0", "--port", "9000"]

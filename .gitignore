# ── Derived indexes — NEVER source of truth (R-2.5) ──────────────────
# basic-memory index rebuilds from wiki/*.md. Deleting it must be safe.
.basic-memory/
*.db
*.db-wal
*.db-shm

# RAG-Anything working artifacts (KG + VDB built from raw/, derived)
rag_storage/
raw/**/kv_store_*.json
raw/**/vdb_*.json
raw/**/graph_*.graphml

# ── Specs — ignored per request ──────────────────────────────────────
specs/

# ── Secrets ──────────────────────────────────────────────────────────
.env
.env.agent_local
.secrets/
config/litellm/.litellm_secrets.yaml

# ── Local Agent Configuration ─────────────────────────────────────────
.agent-local/

# ── Spike outputs ───────────────────────────────────────────────────
spikes/**/out/
spikes/**/*.tmp
spikes/**/scratch/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ── Agent contract mirror ────────────────────────────────────────────
# `.claude/{instructions,rules,skills,workflows}` is a TRACKED byte-for-byte
# mirror of `.agent/` (enforced by tests/test_agent_package_sync.py). Do not
# ignore it: an untracked mirror silently drifts from the authoritative
# `.agent/` contract and the drift never reaches code review.
# Only Claude Code's per-machine state below is ignored.
.claude/settings.local.json
.claude/*.local.json

# ── Editor / tooling / OS ────────────────────────────────────────────
.vscode/
.idea/
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts and local run logs
dist/
e2e_demo/

# Inbox for files awaiting triage. The PDF here is byte-identical to the copy
# under raw/papers/, which is the tracked one; keeping both would duplicate
# 2.5 MB in history forever. Notes and policies in this folder stay tracked.
docs/news-file_need-check/*.pdf

# Extracted figures and tables. Regenerated deterministically from raw/ by
# `snpmemory extract`; byte-identical every run, so there is nothing to preserve.
derived/
